{
  "cloud": "azure",
  "ssh": {
    "user": "deployer",
    "public_key_path": "~/.ssh/coinops_gcp.pub",
    "private_key_path": "~/.ssh/coinops_gcp"
  },
  "deploy": {
    "runtime_backend": "external",
    "image_registry": "ghcr.io/ua-academy-projects",
    "image_tag": "shabat-latest",
    "app_domain": "coinops.test",
    "tls_mode": "selfsigned"
  },
  "networks": {
    "main": {
      "cloud": "azure",
      "name": "coinops-network",
      "cidr": "10.10.0.0/16",
      "subnets": {
        "app": {
          "cidr": "10.10.1.0/24",
          "placement": "primary",
          "exposure": "private"
        },
        "edge": {
          "cidr": "10.10.2.0/24",
          "placement": "primary",
          "exposure": "public"
        }
      }
    },
    "secondary": {
      "cloud": "gcp",
      "name": "coinops-network-gcp",
      "cidr": "10.20.0.0/16",
      "subnets": {
        "edge": {
          "cidr": "10.20.1.0/24",
          "placement": "primary",
          "exposure": "public"
        }
      }
    }
  },
  "nat_route": {
    "name": "coinops-private-egress",
    "destination_range": "0.0.0.0/0",
    "instance_workload": "coinops-frontend",
    "target_tags": ["private-egress"],
    "private_cidr": "10.10.1.0/24"
  },
  "secrets": {
    "ghcr_username": {
      "secret_id": "ghcr-username"
    },
    "ghcr_token": {
      "secret_id": "ghcr-token"
    },
    "rabbitmq_password": {
      "secret_id": "rabbitmq-password"
    },
    "db_password": {
      "secret_id": "db-password"
    }
  },
  "sql": {
    "placement": "primary",
    "instance": {
      "name": "coinops-postgres",
      "edition": "enterprise",
      "database_version": "postgres_16",
      "instance_type": "economical",
      "availability_type": "single_zone",
      "disk_type": "hdd",
      "disk_size": 10,
      "disk_autoresize": true,
      "deletion_protection": false,
      "backup_enabled": true,
      "pitr_enabled": false,
      "private_range_name": "coinops-cloudsql-private-range",
      "private_range_cidr": 16
    },
    "database": {
      "name": "cognitor"
    },
    "user": {
      "name": "cognitor"
    }
  },
  "workloads": {
    "coinops-frontend": {
      "roles": ["ui", "bastion", "nat"],
      "instance_type": "micro",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "edge",
      "tags": ["ssh", "ui", "ui-http", "ui-https", "nat", "bastion"],
      "disk_size_gb": 20,
      "public_ip": true,
      "can_ip_forward": true,
      "allowed_ports": [22, 80, 443],
      "identity": "ui",
      "secrets": ["ghcr_username", "ghcr_token"]
    },
    "coinops-backend": {
      "roles": ["proxy", "history"],
      "instance_type": "micro",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "app",
      "tags": ["ssh", "proxy-api", "history-api", "postgres", "private-egress"],
      "disk_size_gb": 20,
      "public_ip": false,
      "can_ip_forward": false,
      "allowed_ports": [22, 8080, 5432, 5672, 15672, 8000],
      "identity": "proxy",
      "secrets": ["ghcr_username", "ghcr_token", "rabbitmq_password", "db_password"]
    },
    "coinops-test": {
      "cloud": "gcp",
      "roles": [],
      "instance_type": "micro",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "edge",
      "tags": ["ssh"],
      "disk_size_gb": 20,
      "public_ip": true,
      "can_ip_forward": false,
      "allowed_ports": []
    }
  },
  "security_rules": {
    "ssh_bastion": {
      "description": "Allow SSH from my IP to bastion",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["22"],
      "cidr_blocks": ["178.212.243.21/32"],
      "source_workloads": [],
      "target_workloads": ["coinops-frontend"]
    },
    "ssh_internal": {
      "description": "Allow SSH from bastion to internal instances",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["22"],
      "cidr_blocks": [],
      "source_workloads": ["coinops-frontend"],
      "target_workloads": ["coinops-backend"]
    },
    "ui_http": {
      "description": "Allow HTTP to UI",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["80"],
      "cidr_blocks": ["0.0.0.0/0"],
      "source_workloads": [],
      "target_workloads": ["coinops-frontend"]
    },
    "ui_https": {
      "description": "Allow HTTPS to UI",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["443"],
      "cidr_blocks": ["0.0.0.0/0"],
      "source_workloads": [],
      "target_workloads": ["coinops-frontend"]
    },
    "proxy_api": {
      "description": "Allow UI to reach proxy API",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["8080"],
      "cidr_blocks": [],
      "source_workloads": ["coinops-frontend"],
      "target_workloads": ["coinops-backend"]
    },
    "history_api": {
      "description": "Allow UI to reach history API",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["8000"],
      "cidr_blocks": [],
      "source_workloads": ["coinops-frontend"],
      "target_workloads": ["coinops-backend"]
    },
    "rabbitmq": {
      "description": "Allow proxy to reach RabbitMQ on history node",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["5672"],
      "cidr_blocks": [],
      "source_workloads": ["coinops-backend"],
      "target_workloads": ["coinops-backend"]
    },
    "nat_forward_tcp": {
      "description": "Allow private app nodes to forward TCP traffic through NAT",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": [],
      "cidr_blocks": [],
      "source_workloads": ["coinops-backend"],
      "target_workloads": ["coinops-frontend"]
    },
    "nat_forward_udp": {
      "description": "Allow private app nodes to forward UDP traffic through NAT",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "udp",
      "ports": [],
      "cidr_blocks": [],
      "source_workloads": ["coinops-backend"],
      "target_workloads": ["coinops-frontend"]
    },
    "nat_forward_icmp": {
      "description": "Allow private app nodes to forward ICMP traffic through NAT",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "icmp",
      "ports": [],
      "cidr_blocks": [],
      "source_workloads": ["coinops-backend"],
      "target_workloads": ["coinops-frontend"]
    },
    "postgres": {
      "description": "Allow app nodes to reach PostgreSQL",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["5432"],
      "cidr_blocks": [],
      "source_workloads": ["coinops-backend"],
      "target_workloads": ["coinops-backend"]
    }
  }
}
