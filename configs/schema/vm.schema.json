{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coin-Ops VM Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cloud": true,
    "ssh": true,
    "deploy": true,
    "networks": true,
    "provider": true,
    "workloads": true,
    "security_rules": true,
    "nat_route": true,
    "secrets": true,
    "sql": true,
    "aks": true,
    "ingress_controller": true,
    "cert_manager": true,
    "jenkins": true
  },
  "allOf": [
    {
      "$ref": "./base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "workloads": {
          "type": "object",
          "additionalProperties": {
            "$ref": "./defs.json#/$defs/workload"
          }
        },
        "security_rules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "./defs.json#/$defs/securityRule"
          }
        },
        "nat_route": {
          "$ref": "./defs.json#/$defs/natRoute"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "./defs.json#/$defs/secretRef"
          }
        },
        "sql": {
          "$ref": "./defs.json#/$defs/sql"
        },
        "aks": {
          "$ref": "./defs.json#/$defs/aks"
        },
        "ingress_controller": {
          "$ref": "./defs.json#/$defs/ingressController"
        },
        "cert_manager": {
          "$ref": "./defs.json#/$defs/certManager"
        },
        "jenkins": {
          "$ref": "./defs.json#/$defs/jenkins"
        }
      }
    }
  ]
}
