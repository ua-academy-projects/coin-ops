{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cloud": {
      "type": "string",
      "enum": ["gcp", "aws", "azure"]
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "public_key_path", "private_key_path"],
      "properties": {
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]*$"
        },
        "public_key_path": {
          "type": "string",
          "pattern": "^(~\\/|\\/).+\\.pub$"
        },
        "private_key_path": {
          "type": "string",
          "pattern": "^(~\\/|\\/).+$"
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime_backend": {
          "type": "string",
          "enum": ["external", "postgres"]
        },
        "image_registry": {
          "type": "string",
          "minLength": 1
        },
        "image_tag": {
          "type": "string",
          "minLength": 1
        },
        "app_domain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
        },
        "tls_mode": {
          "type": "string",
          "enum": ["off", "selfsigned", "letsencrypt"]
        },
        "letsencrypt_email": {
          "type": "string",
          "format": "email"
        },
        "external_db_host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+$"
        }
      }
    },
    "subnet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidr", "placement", "exposure"],
      "properties": {
        "cidr": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
        },
        "placement": {
          "type": "string",
          "enum": ["primary", "secondary"]
        },
        "exposure": {
          "type": "string",
          "enum": ["public", "private"]
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cidr", "subnets"],
      "properties": {
        "cloud": {
          "$ref": "#/$defs/cloud"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cidr": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
        },
        "subnets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/subnet"
          }
        }
      }
    },
    "providerAzure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_group_name": {
          "type": "string",
          "minLength": 1
        },
        "key_vault_name": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "instance_type",
        "image_family",
        "placement",
        "subnet",
        "tags",
        "disk_size_gb",
        "public_ip",
        "can_ip_forward",
        "allowed_ports"
      ],
      "properties": {
        "cloud": {
          "$ref": "#/$defs/cloud"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instance_type": {
          "type": "string",
          "minLength": 1
        },
        "image_family": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "type": "string",
          "enum": ["primary", "secondary"]
        },
        "subnet": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disk_size_gb": {
          "type": "integer",
          "minimum": 1
        },
        "public_ip": {
          "type": "boolean"
        },
        "can_ip_forward": {
          "type": "boolean"
        },
        "allowed_ports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "secrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "securityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "direction",
        "priority",
        "protocol",
        "ports",
        "cidr_blocks",
        "source_workloads",
        "target_workloads"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": ["INGRESS", "EGRESS"]
        },
        "priority": {
          "type": "integer",
          "minimum": 100,
          "maximum": 65535
        },
        "protocol": {
          "type": "string",
          "enum": ["tcp", "udp", "icmp"]
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,5}|[0-9]{1,5}-[0-9]{1,5})$"
          }
        },
        "cidr_blocks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
          }
        },
        "source_workloads": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_workloads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "natRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "destination_range",
        "instance_workload",
        "target_tags",
        "private_cidr"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "destination_range": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
        },
        "instance_workload": {
          "type": "string",
          "minLength": 1
        },
        "target_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "private_cidr": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
        }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_id"],
      "properties": {
        "secret_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sqlInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "edition",
        "database_version",
        "instance_type",
        "availability_type",
        "disk_type",
        "disk_size",
        "disk_autoresize",
        "deletion_protection",
        "backup_enabled",
        "pitr_enabled",
        "private_range_name",
        "private_range_cidr"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "database_version": {
          "type": "string",
          "minLength": 1
        },
        "instance_type": {
          "type": "string",
          "minLength": 1
        },
        "availability_type": {
          "type": "string",
          "minLength": 1
        },
        "disk_type": {
          "type": "string",
          "minLength": 1
        },
        "disk_size": {
          "type": "integer",
          "minimum": 1
        },
        "disk_autoresize": {
          "type": "boolean"
        },
        "deletion_protection": {
          "type": "boolean"
        },
        "backup_enabled": {
          "type": "boolean"
        },
        "pitr_enabled": {
          "type": "boolean"
        },
        "private_range_name": {
          "type": "string",
          "minLength": 1
        },
        "private_range_cidr": {
          "type": "integer",
          "minimum": 8,
          "maximum": 30
        }
      }
    },
    "sqlDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sqlUser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "instance", "database", "user"],
      "properties": {
        "placement": {
          "type": "string",
          "enum": ["primary", "secondary"]
        },
        "instance": {
          "$ref": "#/$defs/sqlInstance"
        },
        "database": {
          "$ref": "#/$defs/sqlDatabase"
        },
        "user": {
          "$ref": "#/$defs/sqlUser"
        }
      }
    },
    "aks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dns_prefix",
        "subnet",
        "node_pool"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "dns_prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 54
        },
        "kubernetes_version": {
          "type": "string",
          "minLength": 1
        },
        "subnet": {
          "type": "string",
          "minLength": 1
        },
        "sku_tier": {
          "type": "string",
          "enum": ["Free", "Standard", "Premium"]
        },
        "node_pool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "vm_size",
            "node_count",
            "os_disk_size_gb"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]{0,11}$"
            },
            "vm_size": {
              "type": "string",
              "minLength": 1
            },
            "node_count": {
              "type": "integer",
              "minimum": 1
            },
            "os_disk_size_gb": {
              "type": "integer",
              "minimum": 30
            }
          }
        }
      }
    },
    "ingressController": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "namespace",
        "release_name",
        "chart_repository",
        "chart_name",
        "service_type",
        "ingress_class_name",
        "default_class"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["traefik"]
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "release_name": {
          "type": "string",
          "minLength": 1
        },
        "chart_repository": {
          "type": "string",
          "format": "uri"
        },
        "chart_name": {
          "type": "string",
          "minLength": 1
        },
        "chart_version": {
          "type": "string",
          "minLength": 1
        },
        "service_type": {
          "type": "string",
          "enum": ["ClusterIP", "LoadBalancer"]
        },
        "ingress_class_name": {
          "type": "string",
          "minLength": 1
        },
        "default_class": {
          "type": "boolean"
        }
      }
    },
    "jenkins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "release_name",
        "chart_repository",
        "chart_name",
        "service_type",
        "admin_secret_name",
        "admin_username",
        "admin_password_placeholder",
        "deploy_job"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "release_name": {
          "type": "string",
          "minLength": 1
        },
        "chart_repository": {
          "type": "string",
          "format": "uri"
        },
        "chart_name": {
          "type": "string",
          "minLength": 1
        },
        "service_type": {
          "type": "string",
          "enum": ["ClusterIP", "LoadBalancer"]
        },
        "admin_secret_name": {
          "type": "string",
          "minLength": 1
        },
        "admin_username": {
          "type": "string",
          "minLength": 1
        },
        "admin_password_placeholder": {
          "type": "string",
          "minLength": 1
        },
        "jcasc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system_message",
            "jenkins_url",
            "agent_namespace",
            "agent_service_account",
            "agent_label"
          ],
          "properties": {
            "system_message": {
              "type": "string",
              "minLength": 1
            },
            "jenkins_url": {
              "type": "string",
              "minLength": 1
            },
            "agent_namespace": {
              "type": "string",
              "minLength": 1
            },
            "agent_service_account": {
              "type": "string",
              "minLength": 1
            },
            "agent_label": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "deploy_job": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "repo_url",
            "branch",
            "script_path"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "repo_url": {
              "type": "string",
              "format": "uri"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "script_path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
