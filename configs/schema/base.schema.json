{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coin-Ops Base Config",
  "type": "object",
  "required": ["cloud", "ssh", "networks"],
  "properties": {
    "cloud": {
      "$ref": "./defs.json#/$defs/cloud"
    },
    "ssh": {
      "$ref": "./defs.json#/$defs/ssh"
    },
    "deploy": {
      "$ref": "./defs.json#/$defs/deploy"
    },
    "networks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "./defs.json#/$defs/network"
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "azure": {
          "$ref": "./defs.json#/$defs/providerAzure"
        }
      }
    }
  }
}
