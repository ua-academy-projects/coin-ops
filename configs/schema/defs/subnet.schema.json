{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coin-ops.local/schema/configs/v1/defs/subnet",
  "title": "Subnet",
  "type": "object",
  "additionalProperties": false,
  "required": ["cidr", "placement", "exposure"],
  "properties": {
    "cidr": {
      "type": "string",
      "minLength": 1
    },
    "placement": {
      "type": "string",
      "minLength": 1
    },
    "exposure": {
      "type": "string",
      "enum": ["public", "private"]
    }
  }
}
