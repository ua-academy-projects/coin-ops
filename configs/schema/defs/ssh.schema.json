{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coin-ops.local/schema/configs/v1/defs/ssh",
  "title": "SSH",
  "type": "object",
  "additionalProperties": false,
  "required": ["user", "public_key_path", "private_key_path"],
  "properties": {
    "user": {
      "type": "string",
      "minLength": 1
    },
    "public_key_path": {
      "type": "string",
      "minLength": 1
    },
    "private_key_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
