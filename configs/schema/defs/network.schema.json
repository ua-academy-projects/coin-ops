{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coin-ops.local/schema/configs/v1/defs/network",
  "title": "Network",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "cidr", "subnets"],
  "properties": {
    "cloud": {
      "$ref": "./cloud.schema.json"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "cidr": {
      "type": "string",
      "minLength": 1
    },
    "subnets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "./subnet.schema.json"
      }
    }
  }
}
