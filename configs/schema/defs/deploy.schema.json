{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coin-ops.local/schema/configs/v1/defs/deploy",
  "title": "Deploy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runtime_backend": {
      "type": "string",
      "enum": ["external", "postgres"]
    },
    "image_registry": {
      "type": "string",
      "minLength": 1
    },
    "image_tag": {
      "type": "string",
      "minLength": 1
    },
    "app_domain": {
      "type": "string",
      "minLength": 1
    },
    "tls_mode": {
      "type": "string",
      "enum": ["off", "selfsigned", "letsencrypt"]
    },
    "letsencrypt_email": {
      "type": "string",
      "minLength": 1
    },
    "external_db_host": {
      "type": "string",
      "minLength": 1
    }
  }
}
