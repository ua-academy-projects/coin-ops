{
  "cloud": "azure",
  "ssh": {
    "user": "deployer",
    "public_key_path": "~/.ssh/coinops_gcp.pub",
    "private_key_path": "~/.ssh/coinops_gcp"
  },
  "deploy": {
    "runtime_backend": "external",
    "image_registry": "ghcr.io/ua-academy-projects",
    "image_tag": "shabat-latest",
    "app_domain": "coinops.arturvolynets.pp.ua",
    "tls_mode": "letsencrypt",
    "letsencrypt_email": "volunetsartur@gmail.com"
  },
  "networks": {
    "aks": {
      "cloud": "azure",
      "name": "coinops-aks-network",
      "cidr": "10.50.0.0/16",
      "subnets": {
        "nodes": {
          "cidr": "10.50.1.0/24",
          "placement": "primary",
          "exposure": "private"
        }
      }
    }
  },
  "secrets": {
    "ghcr_username": {
      "secret_id": "ghcr-username"
    },
    "ghcr_token": {
      "secret_id": "ghcr-token"
    },
    "rabbitmq_password": {
      "secret_id": "rabbitmq-password"
    },
    "db_password": {
      "secret_id": "db-password"
    }
  },
  "sql": {
    "placement": "primary",
    "instance": {
      "name": "coinops-postgres",
      "edition": "enterprise",
      "database_version": "postgres_16",
      "instance_type": "economical",
      "availability_type": "single_zone",
      "disk_type": "hdd",
      "disk_size": 32,
      "disk_autoresize": true,
      "deletion_protection": false,
      "backup_enabled": true,
      "pitr_enabled": false,
      "private_range_name": "coinops-postgres-private-range",
      "private_range_cidr": 24
    },
    "database": {
      "name": "cognitor"
    },
    "user": {
      "name": "cognitor"
    }
  },
  "aks": {
    "name": "coinops-aks",
    "dns_prefix": "coinops",
    "subnet": "nodes",
    "sku_tier": "Free",
    "node_pool": {
      "name": "system",
      "vm_size": "Standard_B2s_v2",
      "node_count": 1,
      "os_disk_size_gb": 30
    }
  },
  "ingress_controller": {
    "type": "traefik",
    "namespace": "traefik",
    "release_name": "traefik",
    "chart_repository": "https://traefik.github.io/charts",
    "chart_name": "traefik",
    "chart_version": "36.3.0",
    "service_type": "LoadBalancer",
    "ingress_class_name": "traefik",
    "default_class": true
  },
  "cert_manager": {
    "namespace": "cert-manager",
    "release_name": "cert-manager",
    "chart_repository": "https://charts.jetstack.io",
    "chart_name": "cert-manager",
    "chart_version": "v1.17.0",
    "cluster_issuer_name": "letsencrypt",
    "acme_server": "https://acme-v02.api.letsencrypt.org/directory",
    "ingress_class_name": "traefik"
  },
  "jenkins": {
    "namespace": "jenkins",
    "release_name": "jenkins",
    "chart_repository": "https://charts.jenkins.io",
    "chart_name": "jenkins",
    "service_type": "ClusterIP",
    "admin_secret_name": "jenkins-admin",
    "admin_username": "admin",
    "admin_password_placeholder": "CHANGE_ME_IN_JENKINS_SECRET",
    "jcasc": {
      "system_message": "Coin-Ops Jenkins is configured by Terraform and JCasC.",
      "jenkins_url": "http://jenkins.jenkins.svc.cluster.local:8080",
      "agent_namespace": "jenkins",
      "agent_service_account": "jenkins-deployer",
      "agent_label": "aks"
    },
    "deploy_job": {
      "name": "deploy-coin-ops",
      "repo_url": "https://github.com/ua-academy-projects/coin-ops.git",
      "branch": "*/volynets-infra-dev",
      "script_path": "jenkins/pipelines/deploy-coin-ops.Jenkinsfile"
    }
  }
}
