{
  "cloud": "azure",
  "ssh": {
    "user": "deployer",
    "public_key_path": "~/.ssh/coinops_gcp.pub",
    "private_key_path": "~/.ssh/coinops_gcp"
  },
  "deploy": {
    "runtime_backend": "external",
    "image_registry": "ghcr.io/ua-academy-projects",
    "image_tag": "shabat-latest",
    "app_domain": "coinops.test",
    "tls_mode": "selfsigned"
  },
  "networks": {
    "minimal": {
      "name": "coinops-aws-minimal",
      "cidr": "10.41.0.0/16",
      "subnets": {
        "public": {
          "cidr": "10.41.1.0/24",
          "placement": "primary",
          "exposure": "public"
        }
      }
    }
  }
}
