# Registry and Image Configuration
IMAGE_REGISTRY=ghcr.io/ua-academy-projects
IMAGE_TAG=shabat-latest
GHCR_USERNAME=
GHCR_TOKEN=

# Infrastructure Provider
CLOUD_PROVIDER=gcp
GCP_PROJECT_ID=
AWS_REGION=us-east-1

# Domain and TLS
APP_DOMAIN=coinops.test
TLS_MODE=selfsigned

# Database Configuration
DB_HOST=localhost
DB_USER=cognitor
DB_PASSWORD=changeme
DB_NAME=cognitor

# RabbitMQ Configuration
RABBITMQ_USER=cognitor
RABBITMQ_PASSWORD=changeme

# Service Ports
PROXY_PORT=8080
HISTORY_PORT=8000
UI_PORT=80
