# Copy to .env and fill in non-secret values:
#   cp .env.example .env
#
# Then load before running wrappers manually:
#   source .env
#
# Secrets are no longer expected here by default:
# - AWS    -> Secrets Manager
# - GCP    -> Secret Manager
# - Azure  -> Key Vault

# ── Cloud Selection ───────────────────────────────────────────
# One of: aws, gcp, azure
export CLOUD_PROVIDER=aws

# ── Access / SSH ──────────────────────────────────────────────
export ANSIBLE_USER=valentyn
export SSH_KEY_PATH=~/.ssh/id_rsa

# Optional manual override. Usually not needed because deploy.sh detects it.
# export SSH_ALLOWED_SOURCE_CIDR=1.2.3.4/32

# ── Runtime Mode ──────────────────────────────────────────────
# external = managed PostgreSQL service
# postgres = local runtime PostgreSQL fallback
export RUNTIME_BACKEND=external

# ── Images ────────────────────────────────────────────────────
# registry = pull from GHCR
# local    = use local docker image archives
export IMAGE_SOURCE=registry
export IMAGE_TAG=shabat-latest
export IMAGE_REGISTRY=ghcr.io/ua-academy-projects
export GHCR_USERNAME=your-github-username

# Only needed for local image mode
# export LOCAL_IMAGE_TAG=local
# export LOCAL_IMAGE_ARTIFACT_DIR=/absolute/path/to/.artifacts/images

# ── App / TLS ─────────────────────────────────────────────────
export APP_DOMAIN=coinops.test
export TLS_MODE=selfsigned

# ── Cloudflare DNS ────────────────────────────────────────────
export TF_VAR_cloudflare_zone_name=example.com
export TF_VAR_cloudflare_record_name=app
export TF_VAR_cloudflare_proxied=true
export TF_VAR_cloudflare_account_id=your_cloudflare_account_id

# ── Optional Secret Name Overrides ────────────────────────────
# AWS Secrets Manager
# export AWS_SECRET_DB_PASSWORD_ID=coinops/db-password
# export AWS_SECRET_RABBITMQ_PASSWORD_ID=coinops/rabbitmq-password
# export AWS_SECRET_GHCR_TOKEN_ID=coinops/ghcr-token
# export AWS_SECRET_CLOUDFLARE_TOKEN_ID=coinops/cloudflare-api-token

# GCP Secret Manager
# export GCP_SECRET_DB_PASSWORD_ID=coinops-db-password
# export GCP_SECRET_RABBITMQ_PASSWORD_ID=coinops-rabbitmq-password
# export GCP_SECRET_GHCR_TOKEN_ID=coinops-ghcr-token
# export GCP_SECRET_CLOUDFLARE_TOKEN_ID=coinops-cloudflare-api-token

# Azure Key Vault
# export AZURE_KEY_VAULT_NAME=coinops-kv-valentyn
# export AZURE_SECRET_DB_PASSWORD_ID=coinops-db-password
# export AZURE_SECRET_RABBITMQ_PASSWORD_ID=coinops-rabbitmq-password
# export AZURE_SECRET_GHCR_TOKEN_ID=coinops-ghcr-token
# export AZURE_SECRET_CLOUDFLARE_TOKEN_ID=coinops-cloudflare-api-token
