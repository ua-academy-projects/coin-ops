---
# Backing services for Coin-Ops on k3s: a creds Secret + PostgreSQL, RabbitMQ
# and Redis StatefulSets, each with a stable in-cluster Service for DNS.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ coinops_data_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: coinops-data-creds
  namespace: {{ coinops_data_namespace }}
type: Opaque
stringData:
  POSTGRES_USER: {{ coinops_data_db_user }}
  POSTGRES_PASSWORD: {{ coinops_data_db_password }}
  POSTGRES_DB: {{ coinops_data_db_name }}
  RABBITMQ_DEFAULT_USER: {{ coinops_data_rabbitmq_user }}
  RABBITMQ_DEFAULT_PASS: {{ coinops_data_rabbitmq_password }}
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: {{ coinops_data_namespace }}
spec:
  clusterIP: None
  selector:
    app: postgres
  ports:
    - port: 5432
      targetPort: 5432
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: {{ coinops_data_namespace }}
spec:
  serviceName: postgres
  replicas: 1
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
    spec:
      containers:
        - name: postgres
          image: {{ coinops_postgres_image }}
          envFrom:
            - secretRef:
                name: coinops-data-creds
          env:
            # Subdir so the PVC mountpoint's lost+found doesn't block initdb.
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          ports:
            - containerPort: 5432
          readinessProbe:
            exec:
              command: ["sh", "-c", "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB"]
            initialDelaySeconds: 10
            periodSeconds: 10
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: {{ coinops_data_storage_class }}
        resources:
          requests:
            storage: {{ coinops_postgres_storage }}
---
apiVersion: v1
kind: Service
metadata:
  name: rabbitmq
  namespace: {{ coinops_data_namespace }}
spec:
  clusterIP: None
  selector:
    app: rabbitmq
  ports:
    - port: 5672
      targetPort: 5672
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: rabbitmq
  namespace: {{ coinops_data_namespace }}
spec:
  serviceName: rabbitmq
  replicas: 1
  selector:
    matchLabels:
      app: rabbitmq
  template:
    metadata:
      labels:
        app: rabbitmq
    spec:
      containers:
        - name: rabbitmq
          image: {{ coinops_rabbitmq_image }}
          envFrom:
            - secretRef:
                name: coinops-data-creds
          ports:
            - containerPort: 5672
          readinessProbe:
            exec:
              command: ["rabbitmq-diagnostics", "-q", "ping"]
            initialDelaySeconds: 15
            periodSeconds: 15
          volumeMounts:
            - name: data
              mountPath: /var/lib/rabbitmq
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: {{ coinops_data_storage_class }}
        resources:
          requests:
            storage: {{ coinops_rabbitmq_storage }}
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: {{ coinops_data_namespace }}
spec:
  clusterIP: None
  selector:
    app: redis
  ports:
    - port: 6379
      targetPort: 6379
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: redis
  namespace: {{ coinops_data_namespace }}
spec:
  serviceName: redis
  replicas: 1
  selector:
    matchLabels:
      app: redis
  template:
    metadata:
      labels:
        app: redis
    spec:
      containers:
        - name: redis
          image: {{ coinops_redis_image }}
          ports:
            - containerPort: 6379
          readinessProbe:
            exec:
              command: ["redis-cli", "ping"]
            initialDelaySeconds: 5
            periodSeconds: 10
          volumeMounts:
            - name: data
              mountPath: /data
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: {{ coinops_data_storage_class }}
        resources:
          requests:
            storage: {{ coinops_redis_storage }}
