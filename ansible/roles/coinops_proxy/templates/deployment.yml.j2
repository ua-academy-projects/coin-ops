apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ coinops_proxy_app_name }}
  namespace: {{ coinops_proxy_namespace }}
  labels:
    app.kubernetes.io/name: {{ coinops_proxy_app_name }}
spec:
  replicas: {{ coinops_proxy_replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ coinops_proxy_app_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ coinops_proxy_app_name }}
    spec:
      imagePullSecrets:
        - name: {{ coinops_proxy_image_pull_secret_name }}
      containers:
        - name: proxy
          image: {{ coinops_proxy_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: {{ coinops_proxy_container_port }}
          env:
            - name: PORT
              value: "{{ coinops_proxy_container_port }}"
            - name: RUNTIME_BACKEND
              value: "{{ coinops_proxy_runtime_backend }}"
          envFrom:
            - secretRef:
                name: {{ coinops_proxy_backend_env_secret_name }}
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
