# Headlamp Helm values, rendered by k3s-headlamp. The chart's default
# clusterRoleBinding (cluster-admin) is kept for the learning lab — scope
# clusterRoleName down before putting real workloads on the cluster.
{% if k3s_headlamp_image_tag | length > 0 %}
image:
  tag: "{{ k3s_headlamp_image_tag }}"
{% endif %}

serviceAccount:
  create: true

clusterRoleBinding:
  create: true
  clusterRoleName: cluster-admin

ingress:
  enabled: true
  ingressClassName: traefik
  annotations:
    cert-manager.io/cluster-issuer: {{ cert_manager_cluster_issuer }}
  hosts:
    - host: {{ k3s_headlamp_host }}
      paths:
        - path: /
          type: Prefix
  tls:
    - secretName: headlamp-tls
      hosts:
        - {{ k3s_headlamp_host }}

resources:
  requests:
    cpu: 50m
    memory: 128Mi
  limits:
    cpu: 300m
    memory: 256Mi
