---
# Homepage dashboard — Namespace + ConfigMap + Deployment + Service + Ingress.
# The config files (settings/bookmarks/services/widgets) are mounted from the
# ConfigMap at /app/config. Edit the bookmarks/services below — pure config.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ homepage_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-config
  namespace: {{ homepage_namespace }}
data:
  settings.yaml: |
    title: Coin-Ops Lab
    theme: dark
    headerStyle: clean
  # Homepage needs these files to exist; empty is fine (no docker/k8s widgets).
  docker.yaml: ""
  kubernetes.yaml: ""
  widgets.yaml: |
    - resources:
        cpu: true
        memory: true
    - search:
        provider: duckduckgo
        target: _blank
  services.yaml: |
    - Coin-Ops:
        - Production site:
            href: https://coinops.pp.ua
            description: AWS compose stack (customer-facing)
        - Headlamp:
            href: https://headlamp.{{ k3s_ingress_domain }}
            description: Kubernetes dashboard for this k3s cluster
  bookmarks.yaml: |
    - Watch:
        - YouTube:
            - abbr: YT
              href: https://www.youtube.com
    - Lab:
        - Hello workload:
            - abbr: HI
              href: https://hello.{{ k3s_ingress_domain }}
        - Headlamp:
            - abbr: HL
              href: https://headlamp.{{ k3s_ingress_domain }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homepage
  namespace: {{ homepage_namespace }}
  labels:
    app: homepage
spec:
  replicas: {{ homepage_replicas }}
  selector:
    matchLabels:
      app: homepage
  template:
    metadata:
      labels:
        app: homepage
    spec:
      containers:
        - name: homepage
          image: {{ homepage_image }}
          ports:
            - containerPort: 3000
          env:
            # Required since homepage v0.9: allow the ingress host.
            - name: HOMEPAGE_ALLOWED_HOSTS
              value: {{ homepage_host }}
            # Log to stdout so the read-only config mount isn't written to.
            - name: LOG_TARGETS
              value: stdout
          volumeMounts:
            - name: config
              mountPath: /app/config
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 256Mi
      volumes:
        - name: config
          configMap:
            name: homepage-config
---
apiVersion: v1
kind: Service
metadata:
  name: homepage
  namespace: {{ homepage_namespace }}
spec:
  type: ClusterIP
  selector:
    app: homepage
  ports:
    - port: 80
      targetPort: 3000
      protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: homepage
  namespace: {{ homepage_namespace }}
  annotations:
    cert-manager.io/cluster-issuer: {{ cert_manager_cluster_issuer }}
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - {{ homepage_host }}
      secretName: homepage-tls
  rules:
    - host: {{ homepage_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: homepage
                port:
                  number: 80
