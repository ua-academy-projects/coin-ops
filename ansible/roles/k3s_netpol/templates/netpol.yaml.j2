{# Data-tier NetworkPolicies. App-tier policies live in the coinops-app Helm chart. #}
{% set ns_data = [coinops_rabbitmq_namespace, coinops_redis_namespace] %}
{% for ns in ns_data %}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny
  namespace: {{ ns }}
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-dns
  namespace: {{ ns }}
spec:
  podSelector: {}
  policyTypes: [Egress]
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
{% endfor %}
{# rabbitmq #}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-clients
  namespace: {{ coinops_rabbitmq_namespace }}
spec:
  podSelector:
    matchLabels:
      app: rabbitmq
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ coinops_proxy_namespace }}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ coinops_history_consumer_namespace }}
      ports:
        - protocol: TCP
          port: 5672
{# redis #}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-clients
  namespace: {{ coinops_redis_namespace }}
spec:
  podSelector:
    matchLabels:
      app: redis
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ coinops_proxy_namespace }}
      ports:
        - protocol: TCP
          port: 6379
{# postgres: ingress-restricted; egress open (CNPG operator/replication/apiserver) #}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-clients-and-operator
  namespace: {{ coinops_postgres_namespace }}
spec:
  podSelector: {}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: cnpg-system
    - from:
        - podSelector: {}
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ coinops_history_api_namespace }}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ coinops_history_consumer_namespace }}
      ports:
        - protocol: TCP
          port: 5432
