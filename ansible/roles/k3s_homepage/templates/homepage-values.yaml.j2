# Homepage (jameswynn/homepage) Helm values, rendered by k3s-homepage.
# The dashboard config lives under `config:` — edit the services/bookmarks
# below; it's pure config. Ingress is the chart's bjw-s common-library shape.
{% if k3s_homepage_image_tag | length > 0 %}
image:
  tag: "{{ k3s_homepage_image_tag }}"
{% endif %}

# Required since Homepage v0.9: allow the ingress host.
env:
  - name: HOMEPAGE_ALLOWED_HOSTS
    value: "{{ k3s_homepage_host }}"

config:
  settings:
    title: Coin-Ops Lab
    theme: dark
    headerStyle: clean
  # Live Kubernetes widget stays off until we wire RBAC for it (enableRbac).
  kubernetes:
    mode: disable
  docker: {}
  widgets:
    - resources:
        cpu: true
        memory: true
    - search:
        provider: duckduckgo
        target: _blank
  services:
    - Coin-Ops:
        - Production site:
            href: https://coinops.pp.ua
            description: AWS compose stack (customer-facing)
        - Headlamp:
            href: https://headlamp.{{ k3s_ingress_domain }}
            description: Kubernetes dashboard for this k3s cluster
  bookmarks:
    - Watch:
        - YouTube:
            - abbr: YT
              href: https://www.youtube.com
    - Lab:
        - Hello workload:
            - abbr: HI
              href: https://hello.{{ k3s_ingress_domain }}
        - Headlamp:
            - abbr: HL
              href: https://headlamp.{{ k3s_ingress_domain }}

ingress:
  main:
    enabled: true
    ingressClassName: traefik
    annotations:
      cert-manager.io/cluster-issuer: {{ cert_manager_cluster_issuer }}
    hosts:
      - host: {{ k3s_homepage_host }}
        paths:
          - path: /
            pathType: Prefix
    tls:
      - secretName: homepage-tls
        hosts:
          - {{ k3s_homepage_host }}

resources:
  requests:
    cpu: 50m
    memory: 128Mi
  limits:
    cpu: 200m
    # Homepage is a Next.js server; 256Mi OOMKills it on a loop. 512Mi gives headroom.
    memory: 512Mi
