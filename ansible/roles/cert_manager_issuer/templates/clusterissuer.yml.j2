apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ cert_manager_issuer_name }}
spec:
  acme:
    email: {{ cert_manager_acme_email }}
    server: {{ cert_manager_acme_server }}
    privateKeySecretRef:
      name: {{ cert_manager_acme_private_key_secret_name }}
    solvers:
      - selector:
          dnsZones:
            - {{ cert_manager_cloudflare_zone }}
        dns01:
          cloudflare:
            apiTokenSecretRef:
              name: {{ cert_manager_cloudflare_k8s_secret_name }}
              key: {{ cert_manager_cloudflare_k8s_secret_key }}

