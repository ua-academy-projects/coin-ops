---
# Coin-Ops on k3s — one workload per namespace. Each app Deployment runs under a
# dedicated ServiceAccount with automountServiceAccountToken:false (no k8s API
# surface; app-to-app traffic is governed by NetworkPolicies in k3s_netpol).
# These Namespaces are also pre-created in tasks/main.yml (the ghcr-pull Secret
# is applied before this template); re-asserting them here is idempotent.
{% for ns in [coinops_proxy_namespace, coinops_history_api_namespace, coinops_history_consumer_namespace, coinops_ui_namespace, coinops_gateway_namespace] %}
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ns }}
---
{% endfor %}
{% for ns in coinops_app_namespaces %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: coinops-app-config
  namespace: {{ ns }}
data:
  RUNTIME_BACKEND: "external"
  PGCLIENTENCODING: "UTF8"
  CORS_ALLOWED_ORIGINS: "{{ coinops_app_cors_origin }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: coinops-app-secrets
  namespace: {{ ns }}
type: Opaque
stringData:
  DATABASE_URL: "{{ coinops_app_database_url }}"
  RABBITMQ_URL: "{{ coinops_app_rabbitmq_url }}"
  REDIS_URL: "{{ coinops_app_redis_url }}"
---
{% endfor %}
# proxy
apiVersion: v1
kind: ServiceAccount
metadata:
  name: coinops-proxy
  namespace: {{ coinops_proxy_namespace }}
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: proxy
  namespace: {{ coinops_proxy_namespace }}
  labels:
    app: proxy
spec:
  replicas: 1
  selector:
    matchLabels:
      app: proxy
  template:
    metadata:
      labels:
        app: proxy
    spec:
      serviceAccountName: coinops-proxy
      imagePullSecrets:
        - name: ghcr-pull
      containers:
        - name: proxy
          image: {{ coinops_proxy_image }}
          envFrom:
            - configMapRef:
                name: coinops-app-config
            - secretRef:
                name: coinops-app-secrets
          env:
            - name: PORT
              value: "{{ coinops_proxy_port }}"
          ports:
            - containerPort: {{ coinops_proxy_port }}
---
apiVersion: v1
kind: Service
metadata:
  name: proxy
  namespace: {{ coinops_proxy_namespace }}
spec:
  type: ClusterIP
  selector:
    app: proxy
  ports:
    - port: {{ coinops_proxy_port }}
      targetPort: {{ coinops_proxy_port }}
---
# history-api
apiVersion: v1
kind: ServiceAccount
metadata:
  name: coinops-history-api
  namespace: {{ coinops_history_api_namespace }}
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: history-api
  namespace: {{ coinops_history_api_namespace }}
  labels:
    app: history-api
spec:
  replicas: 1
  selector:
    matchLabels:
      app: history-api
  template:
    metadata:
      labels:
        app: history-api
    spec:
      serviceAccountName: coinops-history-api
      imagePullSecrets:
        - name: ghcr-pull
      containers:
        - name: history-api
          image: {{ coinops_history_api_image }}
          envFrom:
            - configMapRef:
                name: coinops-app-config
            - secretRef:
                name: coinops-app-secrets
          env:
            - name: PORT
              value: "{{ coinops_history_port }}"
          ports:
            - containerPort: {{ coinops_history_port }}
---
apiVersion: v1
kind: Service
metadata:
  name: history-api
  namespace: {{ coinops_history_api_namespace }}
spec:
  type: ClusterIP
  selector:
    app: history-api
  ports:
    - port: {{ coinops_history_port }}
      targetPort: {{ coinops_history_port }}
---
# history-consumer (no Service; nothing connects to it)
apiVersion: v1
kind: ServiceAccount
metadata:
  name: coinops-history-consumer
  namespace: {{ coinops_history_consumer_namespace }}
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: history-consumer
  namespace: {{ coinops_history_consumer_namespace }}
  labels:
    app: history-consumer
spec:
  # Single replica: the consumer is order-sensitive (one RabbitMQ consumer).
  replicas: 1
  selector:
    matchLabels:
      app: history-consumer
  template:
    metadata:
      labels:
        app: history-consumer
    spec:
      serviceAccountName: coinops-history-consumer
      imagePullSecrets:
        - name: ghcr-pull
      containers:
        - name: history-consumer
          image: {{ coinops_history_consumer_image }}
          envFrom:
            - configMapRef:
                name: coinops-app-config
            - secretRef:
                name: coinops-app-secrets
---
# ui (no DB secrets; just the same-origin API base)
apiVersion: v1
kind: ServiceAccount
metadata:
  name: coinops-ui
  namespace: {{ coinops_ui_namespace }}
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ui
  namespace: {{ coinops_ui_namespace }}
  labels:
    app: ui
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ui
  template:
    metadata:
      labels:
        app: ui
    spec:
      serviceAccountName: coinops-ui
      imagePullSecrets:
        - name: ghcr-pull
      containers:
        - name: ui
          image: {{ coinops_ui_image }}
          env:
            - name: PROXY_URL
              value: "https://{{ coinops_app_host }}/api"
            - name: HISTORY_URL
              value: "https://{{ coinops_app_host }}/history-api"
          ports:
            - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: ui
  namespace: {{ coinops_ui_namespace }}
spec:
  type: ClusterIP
  selector:
    app: ui
  ports:
    - port: 80
      targetPort: 80
---
# gateway (edge nginx + the public Ingress)
apiVersion: v1
kind: ServiceAccount
metadata:
  name: coinops-gateway
  namespace: {{ coinops_gateway_namespace }}
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: coinops-gateway-conf
  namespace: {{ coinops_gateway_namespace }}
data:
  default.conf: |
    server {
      listen 80;
      server_name _;

      location = /health {
        access_log off;
        add_header Content-Type application/json;
        return 200 '{"status":"ok"}';
      }

      location /api/ {
        proxy_pass http://proxy.{{ coinops_proxy_namespace }}.svc.cluster.local:{{ coinops_proxy_port }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
      }

      location /history-api/ {
        proxy_pass http://history-api.{{ coinops_history_api_namespace }}.svc.cluster.local:{{ coinops_history_port }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
      }

      location / {
        proxy_pass http://ui.{{ coinops_ui_namespace }}.svc.cluster.local:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gateway
  namespace: {{ coinops_gateway_namespace }}
  labels:
    app: gateway
spec:
  replicas: 1
  selector:
    matchLabels:
      app: gateway
  template:
    metadata:
      labels:
        app: gateway
    spec:
      serviceAccountName: coinops-gateway
      containers:
        - name: gateway
          image: {{ coinops_gateway_image }}
          ports:
            - containerPort: 80
          volumeMounts:
            - name: conf
              mountPath: /etc/nginx/conf.d
      volumes:
        - name: conf
          configMap:
            name: coinops-gateway-conf
---
apiVersion: v1
kind: Service
metadata:
  name: gateway
  namespace: {{ coinops_gateway_namespace }}
spec:
  type: ClusterIP
  selector:
    app: gateway
  ports:
    - port: 80
      targetPort: 80
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: coinops
  namespace: {{ coinops_gateway_namespace }}
  annotations:
    cert-manager.io/cluster-issuer: {{ cert_manager_cluster_issuer }}
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - {{ coinops_app_host }}
      secretName: coinops-app-tls
  rules:
    - host: {{ coinops_app_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: gateway
                port:
                  number: 80
