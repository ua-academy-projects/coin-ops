            matchLabels:
              kubernetes.io/metadata.name: {{ coinops_network_policy_backend_namespace }}
      ports:
        - protocol: TCP
          port: {{ coinops_network_policy_rabbitmq_port }}
    - from:
        - namespaceSelector:
            matchLabels:
