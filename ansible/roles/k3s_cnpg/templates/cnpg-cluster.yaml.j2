---
# CNPG Cluster resource — tells CNPG operator to create a PostgreSQL instance.
# CNPG automatically creates:
#   - Pod with PostgreSQL running inside
#   - PersistentVolumeClaim for data storage
#   - Service <name>-rw (read-write, primary)
#   - Service <name>-ro (read-only, replicas)
#   - Service <name>-r  (read, any instance)
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: {{ cnpg_cluster_name }}
  namespace: {{ cnpg_namespace }}
spec:
  instances: {{ cnpg_instances }}

  storage:
    size: {{ cnpg_storage_size }}

  bootstrap:
    initdb:
      database: {{ cnpg_db_name }}
      owner: {{ cnpg_db_user }}
      secret:
        name: cnpg-db-secret

  postgresql:
    parameters:
      max_connections: "100"
