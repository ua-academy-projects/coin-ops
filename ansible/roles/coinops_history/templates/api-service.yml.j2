apiVersion: v1
kind: Service
metadata:
  name: {{ coinops_history_api_app_name }}
  namespace: {{ coinops_history_namespace }}
  labels:
    app.kubernetes.io/name: {{ coinops_history_api_app_name }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ coinops_history_api_app_name }}
  ports:
    - name: http
      port: {{ coinops_history_api_service_port }}
      targetPort: http
