---
# In-cluster cloudflared for the apps tunnel. Token-based (remotely-managed):
# Cloudflare pushes the ingress routing (-> Traefik) and Access config, so this
# is just the connector. 2 replicas for HA; readiness via the metrics /ready.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ k3s_cloudflared_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-apps-token
  namespace: {{ k3s_cloudflared_namespace }}
type: Opaque
stringData:
  token: "{{ k3s_cloudflared_tunnel_token }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflared
  namespace: {{ k3s_cloudflared_namespace }}
  labels:
    app: cloudflared
spec:
  replicas: {{ k3s_cloudflared_replicas }}
  selector:
    matchLabels:
      app: cloudflared
  template:
    metadata:
      labels:
        app: cloudflared
    spec:
      containers:
        - name: cloudflared
          image: {{ k3s_cloudflared_image }}
          args:
            - tunnel
            - --no-autoupdate
            - --metrics
            - 0.0.0.0:2000
            - run
          env:
            - name: TUNNEL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: cloudflared-apps-token
                  key: token
          livenessProbe:
            httpGet:
              path: /ready
              port: 2000
            initialDelaySeconds: 10
            periodSeconds: 30
          readinessProbe:
            httpGet:
              path: /ready
              port: 2000
            initialDelaySeconds: 5
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
