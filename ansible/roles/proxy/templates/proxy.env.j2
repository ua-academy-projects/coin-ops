# Bootstrap configuration for refactored Coin Ops
CLOUD_PROVIDER={{ cloud_provider }}
CONFIG_PATH=/opt/coinops/config.yaml

# AWS Config
AWS_SECRET_NAME=coinops/production/app-secrets
AWS_REGION=us-east-1

# GCP Config
GCP_PROJECT_ID={{ gcp_project_id }}
GCP_SECRET_ID=coinops-app-secrets

# Legacy fallbacks (optional)
PORT={{ proxy_port }}

# Connection URLs (Application fallbacks)
REDIS_URL="redis://redis:6379/0"
DATABASE_URL="{{ proxy_database_url }}"
RABBITMQ_URL="{{ rabbitmq_url }}"

# Egress Proxy
HTTP_PROXY="{{ app_http_proxy }}"
HTTPS_PROXY="{{ app_http_proxy }}"
NO_PROXY="{{ app_no_proxy }}"
