apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ headlamp_ingress_name }}
  namespace: {{ headlamp_ingress_namespace }}
  annotations:
    cert-manager.io/cluster-issuer: {{ headlamp_ingress_cluster_issuer_name }}
spec:
  ingressClassName: {{ headlamp_ingress_class_name }}
  tls:
    - hosts:
        - {{ headlamp_ingress_domain }}
      secretName: {{ headlamp_ingress_tls_secret_name }}
  rules:
    - host: {{ headlamp_ingress_domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ headlamp_ingress_service_name }}
                port:
                  number: {{ headlamp_ingress_service_port }}
