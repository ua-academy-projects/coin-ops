apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: homepage
  namespace: __NAMESPACE__
spec:
  ingressClassName: nginx
  rules:
    - host: __HOST__
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: homepage
                port:
                  number: 80
