apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ cluster_issuer_name }}
spec:
  acme:
    email: {{ cluster_issuer_email | quote }}
    server: {{ cluster_issuer_server | quote }}
    privateKeySecretRef:
      name: {{ cluster_issuer_private_key_secret_name }}
    solvers:
      - http01:
          ingress:
            ingressClassName: {{ cluster_issuer_ingress_class_name }}
