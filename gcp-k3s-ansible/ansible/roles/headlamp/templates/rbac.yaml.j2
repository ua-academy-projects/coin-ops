apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ headlamp_name }}
  namespace: {{ headlamp_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ headlamp_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
  - kind: ServiceAccount
    name: {{ headlamp_name }}
    namespace: {{ headlamp_namespace }}
