apiVersion: apps/v1
kind: Deployment
metadata:
  name: coinops-history-consumer
  namespace: {{ coinops_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: coinops-history-consumer
  template:
    metadata:
      labels:
        app: coinops-history-consumer
    spec:
      imagePullSecrets:
        - name: {{ coinops_registry_pull_secret_name }}
      containers:
        - name: history-consumer
          image: {{ coinops_history_consumer_image }}
          imagePullPolicy: Always
          env:
            - name: RUNTIME_BACKEND
              value: {{ coinops_runtime_backend | quote }}
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: coinops-runtime-secret
                  key: DATABASE_URL
            - name: RABBITMQ_URL
              valueFrom:
                secretKeyRef:
                  name: coinops-runtime-secret
                  key: RABBITMQ_URL
