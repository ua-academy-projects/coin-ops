apiVersion: apps/v1
kind: Deployment
metadata:
  name: coinops-proxy
  namespace: {{ coinops_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: coinops-proxy
  template:
    metadata:
      labels:
        app: coinops-proxy
    spec:
      imagePullSecrets:
        - name: {{ coinops_registry_pull_secret_name }}
      containers:
        - name: proxy
          image: {{ coinops_proxy_image }}
          imagePullPolicy: Always
          env:
            - name: RUNTIME_BACKEND
              value: {{ coinops_runtime_backend | quote }}
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: coinops-runtime-secret
                  key: DATABASE_URL
            - name: RABBITMQ_URL
              valueFrom:
                secretKeyRef:
                  name: coinops-runtime-secret
                  key: RABBITMQ_URL
            - name: REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: coinops-runtime-secret
                  key: REDIS_URL
            - name: PORT
              value: "{{ coinops_proxy_port }}"
          ports:
            - containerPort: {{ coinops_proxy_port }}
              name: http
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
