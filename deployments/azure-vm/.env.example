# Public domain. Cloudflare A record must point this name to the Azure VM IP.
COINOPS_DOMAIN=coinops.kazachuk-k3s.pp.ua
ACME_EMAIL=you@example.com

# GHCR private images.
IMAGE_REGISTRY=ghcr.io/ua-academy-projects
IMAGE_TAG=dev-latest
GHCR_USERNAME=your-github-username
GHCR_TOKEN=github_pat_or_classic_token_with_read_packages

# Local data services on the Azure VM.
POSTGRES_DB=cognitor
POSTGRES_USER=coinops
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=coinops
RABBITMQ_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Future Entra ID / oauth2-proxy values. Not enabled in the default Caddyfile yet.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_OIDC_ISSUER_URL=
