{
  "cloud": "gcp",
  "networks": {
    "k3s": {
      "cloud": "gcp",
      "name": "coinops-k3s-network",
      "cidr": "10.30.0.0/16",
      "subnets": {
        "k3s": {
          "cidr": "10.30.1.0/24",
          "placement": "primary",
          "exposure": "public"
        }
      }
    }
  },
  "nat_route": null,
  "secrets": {},
  "sql": null,
  "workloads": {
    "k3s-node-01": {
      "roles": ["k3s"],
      "instance_type": "small",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "k3s",
      "tags": ["ssh", "k3s"],
      "disk_size_gb": 30,
      "public_ip": true,
      "can_ip_forward": false
    },
    "k3s-node-02": {
      "roles": ["k3s"],
      "instance_type": "small",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "k3s",
      "tags": ["ssh", "k3s"],
      "disk_size_gb": 30,
      "public_ip": true,
      "can_ip_forward": false
    },
    "k3s-node-03": {
      "roles": ["k3s"],
      "instance_type": "small",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "k3s",
      "tags": ["ssh", "k3s"],
      "disk_size_gb": 30,
      "public_ip": true,
      "can_ip_forward": false
    }
  },
  "role_definitions": {
    "k3s": {
      "allowed_ports": [22]
    }
  },
  "security_rules": {
    "ssh": {
      "description": "Allow SSH to k3s nodes",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["22"],
      "cidr_blocks": ["178.212.243.21/32"],
      "source_workloads": [],
      "target_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"]
    },
    "k3s_api_internal": {
      "description": "Allow K3s API between k3s nodes",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["6443"],
      "cidr_blocks": [],
      "source_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"],
      "target_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"]
    },
    "k3s_etcd_internal": {
      "description": "Allow embedded etcd traffic between k3s server nodes",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["2379-2380"],
      "cidr_blocks": [],
      "source_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"],
      "target_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"]
    }
  }
}
