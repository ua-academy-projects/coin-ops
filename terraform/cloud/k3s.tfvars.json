{
  "cloud": "gcp",
  "networks": {
    "k3s": {
      "cloud": "gcp",
      "name": "coinops-k3s-network",
      "cidr": "10.30.0.0/16",
      "subnets": {
        "k3s": {
          "cidr": "10.30.1.0/24",
          "placement": "primary",
          "exposure": "public"
        }
      }
    }
  },
  "nat_route": {
    "name": "coinops-k3s-private-egress",
    "destination_range": "0.0.0.0/0",
    "instance_workload": "k3s-gateway",
    "target_tags": ["private-egress"]
  },
  "workloads": {
    "k3s-gateway": {
      "roles": ["bastion", "nat", "proxy"],
      "instance_type": "micro",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "k3s",
      "tags": ["ssh", "bastion", "nat"],
      "disk_size_gb": 10,
      "public_ip": true,
      "can_ip_forward": true,
      "allowed_ports": [22, 80, 443]
    },
    "k3s-node-01": {
      "roles": ["k3s"],
      "instance_type": "small",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "k3s",
      "tags": ["ssh", "k3s", "private-egress"],
      "disk_size_gb": 30,
      "public_ip": false,
      "can_ip_forward": false,
      "allowed_ports": [22, 6443, 10250, 2379, 2380]
    },
    "k3s-node-02": {
      "roles": ["k3s"],
      "instance_type": "small",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "k3s",
      "tags": ["ssh", "k3s", "private-egress"],
      "disk_size_gb": 30,
      "public_ip": false,
      "can_ip_forward": false,
      "allowed_ports": [22, 6443, 10250, 2379, 2380]
    },
    "k3s-node-03": {
      "roles": ["k3s"],
      "instance_type": "small",
      "image_family": "ubuntu_24",
      "placement": "primary",
      "subnet": "k3s",
      "tags": ["ssh", "k3s", "private-egress"],
      "disk_size_gb": 30,
      "public_ip": false,
      "can_ip_forward": false,
      "allowed_ports": [22, 6443, 10250, 2379, 2380]
    }
  },
  "security_rules": {
    "ssh_bastion": {
      "description": "Allow SSH from my IP to k3s bastion",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["22"],
      "cidr_blocks": ["178.212.243.21/32"],
      "source_workloads": [],
      "target_workloads": ["k3s-gateway"]
    },
    "ssh_internal": {
      "description": "Allow SSH from k3s bastion to k3s nodes",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["22"],
      "cidr_blocks": [],
      "source_workloads": ["k3s-gateway"],
      "target_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"]
    },
    "k3s_api_internal": {
      "description": "Allow K3s API between k3s nodes",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["6443"],
      "cidr_blocks": [],
      "source_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"],
      "target_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"]
    },
    "k3s_etcd_internal": {
      "description": "Allow embedded etcd traffic between k3s server nodes",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["2379-2380"],
      "cidr_blocks": [],
      "source_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"],
      "target_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"]
    },
    "k3s_flannel_vxlan_internal": {
      "description": "Allow Flannel VXLAN traffic between k3s nodes",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "udp",
      "ports": ["8472"],
      "cidr_blocks": [],
      "source_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"],
      "target_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"]
    },
    "k3s_kubelet_internal": {
      "description": "Allow kubelet API traffic between k3s nodes",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["10250"],
      "cidr_blocks": [],
      "source_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"],
      "target_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"]
    },
    "nat_forward_tcp": {
      "description": "Allow private k3s nodes to forward TCP traffic through NAT",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": [],
      "cidr_blocks": [],
      "source_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"],
      "target_workloads": ["k3s-gateway"]
    },
    "nat_forward_udp": {
      "description": "Allow private k3s nodes to forward UDP traffic through NAT",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "udp",
      "ports": [],
      "cidr_blocks": [],
      "source_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"],
      "target_workloads": ["k3s-gateway"]
    },
    "nat_forward_icmp": {
      "description": "Allow private k3s nodes to forward ICMP traffic through NAT",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "icmp",
      "ports": [],
      "cidr_blocks": [],
      "source_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"],
      "target_workloads": ["k3s-gateway"]
    },
    "http": {
      "description": "Allow HTTP traffic to k3s gateway",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["80"],
      "cidr_blocks": ["0.0.0.0/0"],
      "source_workloads": [],
      "target_workloads": ["k3s-gateway"]
    },
    "https": {
      "description": "Allow HTTPS traffic to k3s gateway",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["443"],
      "cidr_blocks": ["0.0.0.0/0"],
      "source_workloads": [],
      "target_workloads": ["k3s-gateway"]
    },
    "haproxy_to_k3s": {
      "description": "Allow HAProxy on gateway to reach k3s nodes on HTTP/HTTPS",
      "direction": "INGRESS",
      "priority": 1000,
      "protocol": "tcp",
      "ports": ["80", "443"],
      "cidr_blocks": [],
      "source_workloads": ["k3s-gateway"],
      "target_workloads": ["k3s-node-01", "k3s-node-02", "k3s-node-03"]
    }
  }
}
